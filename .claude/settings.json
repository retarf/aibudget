{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Edit(.env)",
      "Edit(./.env)",
      "Write(.env)",
      "Write(./.env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-stop.sh\""
          }
        ]
      }
    ]
  }
}
